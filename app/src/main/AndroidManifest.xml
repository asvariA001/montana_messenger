<?xml version="1.0" encoding="utf-8"?>
<!-- A separate app beside the old Montana on the phone (quest.montana.app): its data and seed stay untouched.
     The code's package stays quest.montana.app — the core's JNI names it. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="quest.montana.app.dev">

    <!-- The one question after the identity (iOS MontanaNotifyGate): the system's own. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- The person's own node: the copy of the history comes back from it (iOS MontanaHomeNode). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- The daily copy rides Wi-Fi alone: the app asks the system which network it stands on. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- The active seed lives device-only (iOS AfterFirstUnlockThisDeviceOnly): no file of the app is copied —
         no Auto Backup (fullBackupContent=false, every domain excluded). The ONE thing the system backup carries
         is SeedBackupAgent's record of the words, and only sealed end to end (iOS MontanaAppleID). -->
    <application
        android:allowBackup="true"
        android:backupAgent="quest.montana.app.SeedBackupAgent"
        android:restoreAnyVersion="true"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher_glass"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Montana">
        <activity
            android:name="quest.montana.app.MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:windowSoftInputMode="adjustResize" />
        <!-- THE APP'S ICON, CHOSEN IN «APPEARANCE» (iOS MTAppIconChooser, setAlternateIconName): the launcher entry is one of two
             aliases of the one activity, and exactly one of them is enabled — the liquid glass (iOS primary, AppIcon.icon)
             by default, the gold on black (iOS AppIconGold) when chosen. -->
        <activity-alias
            android:name="quest.montana.app.IconGlass"
            android:targetActivity="quest.montana.app.MainActivity"
            android:icon="@mipmap/ic_launcher_glass"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name="quest.montana.app.IconGold"
            android:targetActivity="quest.montana.app.MainActivity"
            android:icon="@mipmap/ic_launcher"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <!-- The app's own door to its received files (Media.kt): read-only, granted address by address. -->
        <provider
            android:name="quest.montana.app.MediaProvider"
            android:authorities="quest.montana.app.dev.media"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
