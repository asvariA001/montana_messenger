@@ -2204,0 +2205,31 @@ mod tests {
+
+#[cfg(test)]
+mod session31_envelope_regression {
+    use super::*;
+
+    #[test]
+    fn duplicate_confirmations_cannot_enter_an_envelope() {
+        let bc = BundledConfirmation {
+            node_id: [0x44; 32],
+            endpoint: [0x11; 32],
+            window_index: 1,
+            op_hashes: vec![],
+            reveal_hashes: vec![],
+            signature: Signature::from_array([0; SIGNATURE_SIZE]),
+        };
+        let mut bytes = vec![0; 3722];
+        bytes.extend_from_slice(&0u16.to_le_bytes());
+        bytes.extend_from_slice(&2u16.to_le_bytes());
+        bc.encode(&mut bytes);
+        bc.encode(&mut bytes);
+        assert!(parse_envelope_bundles(&bytes).is_none());
+    }
+
+    #[test]
+    fn trailing_bytes_cannot_enter_an_envelope() {
+        let mut bytes = vec![0; 3726];
+        assert!(parse_envelope_bundles(&bytes).is_some());
+        bytes.push(0x99);
+        assert!(parse_envelope_bundles(&bytes).is_none());
+    }
+}
diff --git a/core/Code/crates/mt-lottery/src/lib.rs b/core/Code/crates/mt-lottery/src/lib.rs
index 00ff153..4962c1a 100644
--- a/core/Code/crates/mt-lottery/src/lib.rs
+++ b/core/Code/crates/mt-lottery/src/lib.rs
@@ -1988,0 +1989,12 @@ mod calibrate_target_binding {
+
+#[cfg(test)]
+#[test]
+fn quorum_does_not_fall_at_the_old_overflow_boundary() {
+    let edge = u64::MAX / 67;
+    for total in [edge - 1, edge, edge + 1, u64::MAX - 1, u64::MAX] {
+        let q = quorum(total);
+        assert!(u128::from(q) * 100 >= u128::from(total) * 67);
+        assert!(u128::from(q - 1) * 100 < u128::from(total) * 67);
+        assert!(q <= total);
+    }
+}
diff --git a/core/Code/crates/mt-messenger-e2e/src/session.rs b/core/Code/crates/mt-messenger-e2e/src/session.rs
index a298529..1628a6c 100644
--- a/core/Code/crates/mt-messenger-e2e/src/session.rs
+++ b/core/Code/crates/mt-messenger-e2e/src/session.rs
@@ -27,0 +28,87 @@ fn pad_message(pt: &[u8]) -> Vec<u8> {
+#[cfg(test)]
+mod adversarial_state_tests {
+    use super::*;
+
+    fn state() -> SessionState {
+        SessionState {
+            session_id: [1; 32],
+            rk: [2; 32],
+            dhs_pub: [3; MLKEM_PUBKEY_SIZE],
+            dhs_sk: vec![4; MLKEM_SK_SIZE],
+            dhr: None,
+            cks: Some([5; 32]),
+            send_ct: None,
+            ckr: None,
+            ns: 9,
+            nr: 0,
+            pn: 2,
+            ratchet_pending: false,
+            mkskipped: Vec::new(),
+        }
+    }
+
+    #[test]
+    fn adversarial_trailing_state_bytes_are_refused() {
+        let mut bytes = state().to_bytes();
+        bytes.push(1);
+        assert!(SessionState::from_bytes(&bytes).is_err());
+    }
+
+    #[test]
+    fn adversarial_noncanonical_pending_flag_is_refused() {
+        let mut bytes = state().to_bytes();
+        let flag = bytes.len() - 5;
+        bytes[flag] = 2;
+        assert!(SessionState::from_bytes(&bytes).is_err());
+    }
+
+    #[test]
+    fn adversarial_skipped_key_count_cannot_exceed_the_runtime_bound() {
+        let mut held = state();
+        for n in 0..=MAX_MKSKIPPED {
+            held.mkskipped.push((vec![3; MLKEM_PUBKEY_SIZE], n as u32, [6; 32]));
+        }
+        assert!(SessionState::from_bytes(&held.to_bytes()).is_err());
+    }
+
+    #[test]
+    fn adversarial_exhausted_send_counter_refuses_without_changing_state() {
+        let mut held = state();
+        held.ns = u32::MAX;
+        let before = held.to_bytes();
+        assert!(held.encrypt(b"message", &[7; 64]).is_err());
+        assert!(held.to_bytes() == before, "failed send changed the session");
+    }
+
+    #[test]
+    fn adversarial_failed_ratchet_step_preserves_the_send_state() {
+        let mut held = state();
+        held.ratchet_pending = true;
+        let before = held.to_bytes();
+        assert_eq!(held.encrypt(b"message", &[7; 64]), Err(RatchetError::BadFormat));
+        assert!(held.to_bytes() == before, "failed ratchet step changed the session");
+    }
+
+    #[test]
+    fn regression_limits_exhausted_receive_counter_preserves_state() {
+        let mut held = state();
+        held.nr = u32::MAX;
+        held.dhr = Some([3; MLKEM_PUBKEY_SIZE]);
+        held.ckr = Some([5; 32]);
+        let before = held.to_bytes();
+        let (mk, _) = kdf_ck(&[5; 32]);
+        let (key, nonce) = msg_key(&mk);
+        let ad = ad_bytes(&held.session_id, 0, u32::MAX, &[3; MLKEM_PUBKEY_SIZE]);
+        let body = seal(&key, &nonce, &pad_message(b"message"), &ad);
+        let mut packet = vec![3; MLKEM_PUBKEY_SIZE];
+        packet.push(0);
+        packet.extend_from_slice(&0u32.to_le_bytes());
+        packet.extend_from_slice(&u32::MAX.to_le_bytes());
+        packet.extend_from_slice(&(body.len() as u32).to_le_bytes());
+        packet.extend_from_slice(&body);
+        assert!(held.decrypt(&packet).is_err());
+        assert!(held.to_bytes() == before, "failed receive changed the session");
+    }
+
+}
+
