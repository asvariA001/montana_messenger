+fn add_boundary_polynomial(
+    samples: &[E],
+    trace: Option<&[F]>,
+    shape: Shape,
+    out: &mut [E],
+) -> Result<(), ProveError> {
+    if out.len() != shape.domain() || trace.is_some_and(|v| v.len() != out.len()) {
