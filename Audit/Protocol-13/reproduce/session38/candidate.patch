+use montana_node::attest::{verify_heavy, Standing};
+use montana_node::pulse::{Cohort, Pulse};
+use montana_node::{Configuration, Machine};
+use mt_state::Layout;
+use mt_suite::standing::{weight_commit, Blind};
+
+mod common;
+use common::Scratch;
+
+// This reproduction must run in an isolated network namespace: Machine starts
+// its real transport even though this scenario makes no outbound connection.
+// Passing means the open finding reproduced, never that item 1 is closed.
+#[test]
+fn open_finding_conflicting_member_signatures_produce_order_dependent_cements() {
+    let sender = [0x73u8; 32];
+    let receiver = [0x74u8; 32];
+    let window = 1_000;
+    let parent = [0x22; 32];
+    let aggregate = [0x33; 32];
+    let threshold = mt_pulse::U256::from_be_bytes(&[0xff; 32]);
+    let cohort = Cohort::of(&[Cohort::half_of(&sender), Cohort::half_of(&receiver)])
+        .expect("two admitted members");
+    let sender_branch = cohort.branch_of(&sender).expect("sender membership");
+    let receiver_branch = cohort.branch_of(&receiver).expect("receiver membership");
+    let directory = Scratch::named("window-cement-audit");
+    let (machine, _) = Machine::start(&Configuration::at(&directory.0, "127.0.0.1:0"))
+        .expect("isolated actual node");
+    let other_directory = Scratch::named("window-cement-audit-other");
+    let (other_machine, _) = Machine::start(&Configuration::at(&other_directory.0, "127.0.0.1:0"))
+        .expect("second isolated actual node with its own store");
+    let mut first = Pulse::open(
+        &machine,
+        &receiver,
+        (window, 0, 0),
+        &receiver_branch,
+        parent,
+    )
+    .expect("first verifier");
+    let mut second = Pulse::open(
+        &other_machine,
+        &receiver,
+        (window, 0, 0),
+        &receiver_branch,
+        parent,
+    )
+    .expect("second verifier with identical context");
+    let beacon = first.beacon_of_this_round().expect("opening beacon");
+    assert_eq!(beacon, second.beacon_of_this_round().unwrap());
+    let beacon_id = beacon.id().unwrap();
+    let mut standing = Standing::of_the_window(
+        &sender,
+        window,
+        &sender_branch.siblings,
+        sender_branch.position,
+        sender_branch.standing,
+    )
+    .expect("actual presence prover");
+    let honest = standing.heavy(&sender, beacon_id, parent).unwrap();
+    verify_heavy(&honest, &cohort.root(), &aggregate, 0, 0, &threshold)
+        .expect("positive presence control");
+
+    let wrong_cohort = Cohort::of(&[Cohort::half_of(&receiver)]).unwrap();
+    assert!(verify_heavy(&honest, &wrong_cohort.root(), &aggregate, 0, 0, &threshold).is_err());
+    let mut wrong_key = honest.clone();
+    wrong_key.answering_key = first.standing.key.as_bytes().to_vec();
+    let receiver_seed = mt_derive::pulse::part_key_seed(&receiver, window);
+    let (_, receiver_key) = mt_suite::sign::keypair_from_seed(&receiver_seed);
+    wrong_key.signature = mt_suite::sign::sign(&receiver_key, &wrong_key.signed_scope().unwrap())
+        .unwrap()
+        .as_bytes()
+        .to_vec();
+    assert!(matches!(
+        verify_heavy(&wrong_key, &cohort.root(), &aggregate, 0, 0, &threshold),
+        Err(montana_node::NodeError::Refused {
+            what: "an attestation whose proof of presence does not verify"
+        })
+    ));
+    let mut wrong_proof = honest.clone();
+    wrong_proof.proof[0] ^= 1;
+    let sender_seed = mt_derive::pulse::part_key_seed(&sender, window);
+    let (_, sender_key) = mt_suite::sign::keypair_from_seed(&sender_seed);
+    wrong_proof.signature = mt_suite::sign::sign(&sender_key, &wrong_proof.signed_scope().unwrap())
+        .unwrap()
+        .as_bytes()
+        .to_vec();
+    assert!(matches!(
+        verify_heavy(&wrong_proof, &cohort.root(), &aggregate, 0, 0, &threshold),
+        Err(montana_node::NodeError::Refused {
+            what: "an attestation whose proof of presence does not verify"
+        })
+    ));
+
+    standing.commitment = weight_commit(0, 0, window, Blind::of([0x41; 32], window))
+        .unwrap()
+        .serialize();
+    let zero = standing.heavy(&sender, beacon_id, parent).unwrap();
+    standing.commitment = weight_commit(u64::MAX, 0, window, Blind::of([0x42; 32], window))
+        .unwrap()
+        .serialize();
+    let maximum = standing.heavy(&sender, beacon_id, parent).unwrap();
+    assert_eq!(zero.proof, honest.proof);
+    assert_eq!(maximum.proof, honest.proof);
+    assert_eq!(zero.part_nullifier, maximum.part_nullifier);
+
+    assert!(first
+        .gather(&zero, &cohort.root(), &aggregate, &beacon, &threshold)
+        .unwrap());
+    assert!(second
+        .gather(&maximum, &cohort.root(), &aggregate, &beacon, &threshold)
+        .unwrap());
+    assert!(!first
+        .gather(&maximum, &cohort.root(), &aggregate, &beacon, &threshold)
+        .unwrap());
+    assert!(!second
+        .gather(&zero, &cohort.root(), &aggregate, &beacon, &threshold)
+        .unwrap());
