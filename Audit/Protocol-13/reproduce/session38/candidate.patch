+fn duplicate_record_keys_cannot_silently_replace_a_committed_leaf() {
+    let bytes = encoded(
+        &[
+            ([1; 32], records::leaf(b"first").bytes()),
+            ([1; 32], records::leaf(b"second").bytes()),
+        ],
