+    }
+}
+
+#[test]
+fn corrupt_counts_are_refused_before_reserving_their_declared_size() {
+    let empty = State::new().encode().unwrap();
+    for at in [0, 4, 40, 44] {
+        let mut bytes = empty.clone();
+        bytes[at..at + 4].copy_from_slice(&u32::MAX.to_le_bytes());
