+//! Reproductions of missing premises of the complete window statement.
+//!
+//! The running sum of commitments is an indicator, not a binding commitment
+//! to the integer sum. These examples do not break an individual commitment
+//! or establish acceptance by a complete window verifier: that verifier and
+//! the recursively authenticated tree of fresh commitments remain absent.
+
+use mt_suite::standing::{commit, D, ETA, K, LIFT, N};
+
+#[test]
+fn open_finding_four_weight_one_leaves_open_as_weight_five() {
+    let r1 = [[0i8; D]; K];
+    let mut honest_r2 = [[0i8; D]; N];
+    honest_r2[0][0] = ETA;
+    let values = [1u64; 4];
+    let sum = values
+        .iter()
+        .map(|value| commit([*value, 0, 0], &r1, &honest_r2).expect("bounded leaf"))
+        .reduce(|left, right| left.add(&right))
+        .expect("four leaves");
+    let actual_weight: u64 = values.iter().sum();
+    let claimed_weight = actual_weight + 1;
+
+    let mut false_r2 = [[0i8; D]; N];
+    false_r2[0][0] = -1;
+    let false_opening = commit([claimed_weight, 0, 0], &r1, &false_r2).expect("also bounded");
+
+    // The matrix cancels because r1 is zero. At the value's first digit:
+    // 4 * (17 * 1 + 4) = 84 = 17 * 5 - 1. Every constituent and the
+    // false aggregate opening pass the real commitment's randomness bound.
+    assert_eq!(4 * (LIFT + ETA as u32), 5 * LIFT - 1);
+    assert_eq!(sum, false_opening);
+    let bytes = sum.serialize();
+    assert_eq!(u32::from_le_bytes(bytes[..4].try_into().unwrap()), 84);
+    assert!(bytes[4..].iter().all(|byte| *byte == 0));
+
+    // This crosses the actual 67-percent threshold in a parent of weight 7.
+    // A verifier of a fresh tree must establish the child-sum relation;
+    // merely opening the running sum as a short commitment is insufficient.
+    assert!(actual_weight * 100 < 67 * 7);
+    assert!(claimed_weight * 100 >= 67 * 7);
+    println!("OPEN FINDING: four bounded weight-1 commitments sum to a bounded opening of weight 5; 4/7 fails quorum while 5/7 passes");
+}
+
+#[test]
+fn open_finding_integer_carry_is_not_coefficient_addition() {
+    let r1 = [[0i8; D]; K];
+    let r2 = [[0i8; D]; N];
+    let left = commit([255, 0, 0], &r1, &r2).expect("bounded");
+    let right = commit([1, 0, 0], &r1, &r2).expect("bounded");
+    let added = left.add(&right);
+    let integer_sum = commit([256, 0, 0], &r1, &r2).expect("bounded");
+    assert_ne!(added, integer_sum);
+
+    let added = added.serialize();
+    let integer_sum = integer_sum.serialize();
+    let coefficient = |bytes: &[u8], at: usize| {
+        u32::from_le_bytes(bytes[at * 4..(at + 1) * 4].try_into().unwrap())
+    };
+    assert_eq!(coefficient(&added, 0), 256 * LIFT);
+    assert_eq!(coefficient(&added, 1), 0);
+    assert_eq!(coefficient(&integer_sum, 0), 0);
+    assert_eq!(coefficient(&integer_sum, 1), LIFT);
+    println!("OPEN FINDING: coefficient addition does not implement the carry in 255 + 1 = 256; the integer child-sum relation needs its own constraints");
+}
