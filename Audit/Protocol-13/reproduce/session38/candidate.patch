+    let leaves = interleaved();
+    let entries: Vec<_> = leaves.iter().map(|(key, value)| (*key, *value)).collect();
+    let expected = reference(
+        &entries,
+        records::key_bits(),
+        &records::empty_internals(records::key_bits()),
+    );
+    assert_eq!(records::root_of_leaves(&leaves), expected);
+}
